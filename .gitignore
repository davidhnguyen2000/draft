# Generated models — every generator writes a folder here.
/generated/

# Fitted-trend plot output (the JSON in */data/ is the tracked artefact).
plots/

# Sparse clones of upstream robot descriptions, re-fetchable with
# scripts/setup_data.py and datasets/robot_descriptions/scripts/01_fetch_descriptions.py.
datasets/robot_descriptions/cache_extra/

# Training output.
logs/
wandb/

# Rendered videos and evaluation artefacts.
eval_results/

# Local editor and tool config.
.claude/
.vscode/
.pytest_cache/

__pycache__/
MUJOCO_LOG.TXT
*.pyc
*.png
.DS_Store

# Keep the README's and docs' figures. `!assets/` alone is not enough — the
# `*.png` rule above still matches files inside an un-excluded directory.
!assets/
!assets/*.png

# The paper's figures are tracked so the docs can show them;
# scripts/figures/make_all.py redraws them. The rendered plates and clips that
# feed them, under figures/*/, are not.
/figures/*/
!/figures/*.png

# Table V's rows, written by `scripts/train_all.py numbers`. Generated output,
# and the paper pastes them in rather than \input-ing the file, so a committed
# copy is a second place for the same numbers to live and drift.
/figures/*.tex

# Packed result archives (`scripts/train_all.py fetch pack`); uploaded, not committed.
/release/

# LaTeX build products, for the tables a script writes into figures/.
*.aux
*.log
*.synctex.gz
*.fls
*.fdb_latexmk
*.bbl
*.blg
*.out
*.toc
*.pdf

# setuptools build metadata, regenerated by `pip install -e .`.
*.egg-info/

# Overleaf Connect
*.nav
*.snm
*.vrb
*.lot
*.lof
%OUTDIR%/
