  "geometry_trend": {
    "form": "tau/N = 2*pi*sigma_eff*r^2*L,  sigma_eff = sigma0*tau^s*N^-k",
    "volume_form": "pi*r^2*L = tau^(1-s) * N^(k-1) / (2*sigma0)",
